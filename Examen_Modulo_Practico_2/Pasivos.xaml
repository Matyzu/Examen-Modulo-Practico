<Page x:Class="Examen_Modulo_Practico_2.Pasivos"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Title="Pasivos"
      Background="#101216">
    <Page.Resources>
        <Style x:Key="ComponentCardStyle" TargetType="Border">
            <Setter Property="Width" Value="292"/>
            <Setter Property="MinHeight" Value="318"/>
            <Setter Property="Margin" Value="0,0,16,16"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="#171C24"/>
            <Setter Property="BorderBrush" Value="#283242"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1F2733"/>
                    <Setter Property="BorderBrush" Value="#7DD3FC"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="34">
            <TextBlock Text="Componentes pasivos"
                       Foreground="White"
                       FontSize="34"
                       FontWeight="Bold"
                       TextWrapping="Wrap"/>
            <TextBlock Text="Elementos que no amplifican ni generan energia. Se usan para controlar, almacenar, filtrar o proteger señales en un circuito."
                       Foreground="#AAB4C3"
                       FontSize="15"
                       Margin="0,8,0,26"
                       TextWrapping="Wrap"/>

            <ItemsControl ItemsSource="{Binding Components}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource ComponentCardStyle}">
                            <Border.ToolTip>
                                <ToolTip Background="#111827" BorderBrush="#3B82F6" BorderThickness="1">
                                    <StackPanel MaxWidth="260" Margin="4">
                                        <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="Bold" FontSize="14"/>
                                        <TextBlock Text="{Binding CommonUse}" Foreground="#DDE6F3" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                        <TextBlock Text="{Binding Tip}" Foreground="#7DD3FC" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </ToolTip>
                            </Border.ToolTip>
                            <StackPanel>
                                <Border Height="132" Background="#0E1117" CornerRadius="8,8,0,0">
                                    <Image Source="{Binding ImagePath}" Stretch="UniformToFill"/>
                                </Border>
                                <StackPanel Margin="16">
                                    <TextBlock Text="{Binding Name}" Foreground="#7DD3FC" FontSize="20" FontWeight="Bold" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Category}" Foreground="#8D99AA" FontSize="12" FontWeight="SemiBold" Margin="0,3,0,10"/>
                                    <TextBlock Text="{Binding Description}" Foreground="#DDE6F3" FontSize="13" TextWrapping="Wrap" MaxHeight="40"/>
                                    <Border Background="#101722" BorderBrush="#283242" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,12,0,0">
                                        <TextBlock Text="{Binding KeyData}" Foreground="#AAB4C3" FontSize="12.5" TextWrapping="Wrap" MaxHeight="36"/>
                                    </Border>
                                    <Button Content="Ver ficha tecnica"
                                            Tag="{Binding}"
                                            Click="Details_Click"
                                            Background="#1E2632"
                                            Foreground="White"
                                            BorderBrush="#3B82F6"
                                            BorderThickness="1"
                                            Cursor="Hand"
                                            Padding="12,8"
                                            Margin="0,14,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
