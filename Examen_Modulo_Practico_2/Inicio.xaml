<Page x:Class="Examen_Modulo_Practico_2.Inicio"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Title="Inicio"
      Background="#101216">
    <Page.Resources>
        <Style x:Key="CategoryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#171C24"/>
            <Setter Property="BorderBrush" Value="#283242"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Card"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="#1E2632"/>
                                <Setter TargetName="Card" Property="BorderBrush" Value="#3B82F6"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="#24344A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid>
        <Canvas IsHitTestVisible="False">
            <Ellipse Width="5" Height="5" Fill="#62D9FF" Opacity="0.55" Canvas.Left="64" Canvas.Top="42"/>
            <Ellipse Width="3" Height="3" Fill="#A7F3D0" Opacity="0.6" Canvas.Left="238" Canvas.Top="76"/>
            <Ellipse Width="4" Height="4" Fill="#FDE68A" Opacity="0.5" Canvas.Left="612" Canvas.Top="48"/>
            <Ellipse Width="6" Height="6" Fill="#C4B5FD" Opacity="0.45" Canvas.Left="772" Canvas.Top="124"/>
            <Ellipse Width="3" Height="3" Fill="#FDA4AF" Opacity="0.55" Canvas.Left="116" Canvas.Top="292"/>
        </Canvas>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="34">
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.15*"/>
                    <ColumnDefinition Width="0.85*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,24,0">
                    <TextBlock Text="Categorias"
                               Foreground="White"
                               FontSize="36"
                               FontWeight="Bold"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="Selecciona una seccion para consultar componentes electronicos, ver imagenes y abrir fichas tecnicas educativas."
                               Foreground="#AAB4C3"
                               FontSize="15"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap"/>
                    <StackPanel Margin="0,12,0,0">
                        <Border Background="#0E1117" BorderBrush="#324055" BorderThickness="2" CornerRadius="8" Padding="4" Width="360" Height="36">
                            <TextBox x:Name="SearchBox"
                                     Width="352"
                                     Height="28"
                                     VerticalContentAlignment="Center"
                                     Background="Transparent"
                                     Foreground="#DDE6F3"
                                     BorderThickness="0"
                                     Padding="4"
                                     TextChanged="SearchBox_TextChanged"
                                     ToolTip="Buscar componente o categoria..."/>
                        </Border>

                        <Popup x:Name="SearchPopup"
                               PlacementTarget="{Binding ElementName=SearchBox}"
                               Placement="Bottom"
                               StaysOpen="False"
                               AllowsTransparency="True"
                               PopupAnimation="Fade">
                            <Border Background="#0B0E12" BorderBrush="#1F2933" BorderThickness="1" CornerRadius="8">
                                <ListBox x:Name="SearchResultsList"
                                         Width="360"
                                         MaxHeight="320"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         SelectionChanged="SearchResultsList_SelectionChanged">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="8" Background="#0E1117" CornerRadius="6" Margin="0,4,0,4">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Type}" Foreground="#62D9FF" FontSize="12"/>
                                                    <TextBlock Text="{Binding Title}" Foreground="#E5E7EB" FontSize="14" FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                        </Popup>
                    </StackPanel>
                </StackPanel>

                <Border Grid.Column="1"
                        Background="#151B24"
                        BorderBrush="#324055"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="116"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="96"
                                Height="96"
                                Background="#0E1117"
                                BorderBrush="#283242"
                                BorderThickness="1"
                                CornerRadius="8"
                                VerticalAlignment="Top">
                            <Image x:Name="PreviewImage"
                                   Source="Assets/Components/resistencia.png"
                                   Stretch="Uniform"
                                   Margin="10"/>
                        </Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock x:Name="PreviewTitle"
                                       Text="Pasa el mouse por una categoria"
                                       Foreground="#E5E7EB"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       TextWrapping="Wrap"/>
                            <TextBlock x:Name="PreviewDescription"
                                       Text="Aqui aparecera una descripcion rapida, un ejemplo de componente y su imagen."
                                       Foreground="#AAB4C3"
                                       FontSize="13"
                                       Margin="0,8,0,0"
                                       TextWrapping="Wrap"/>
                            <TextBlock x:Name="PreviewComponent"
                                       Text="Ejemplo inicial: Resistencia"
                                       Foreground="#62D9FF"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"/>

                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <UniformGrid Columns="2">
                <Button Style="{StaticResource CategoryButtonStyle}"
                        Margin="0,0,14,14"
                        MouseEnter="Pasivos_MouseEnter"
                        Click="Pasivos_Click">
                    <StackPanel Margin="18">
                        <TextBlock Text="Pasivos"
                                   Foreground="#7DD3FC"
                                   FontSize="20"
                                   FontWeight="Bold"/>
                        <TextBlock Text="Resistencias, capacitores, inductores y otros componentes que no amplifican senales."
                                   Foreground="#AAB4C3"
                                   FontSize="13"
                                   Margin="0,8,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource CategoryButtonStyle}"
                        Margin="0,0,0,14"
                        MouseEnter="Activos_MouseEnter"
                        Click="Activos_Click">
                    <StackPanel Margin="18">
                        <TextBlock Text="Activos"
                                   Foreground="#A7F3D0"
                                   FontSize="20"
                                   FontWeight="Bold"/>
                        <TextBlock Text="Transistores, diodos, circuitos integrados y elementos capaces de controlar corriente."
                                   Foreground="#AAB4C3"
                                   FontSize="13"
                                   Margin="0,8,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource CategoryButtonStyle}"
                        Margin="0,0,14,14"
                        MouseEnter="Entradas_MouseEnter"
                        Click="Entradas_Click">
                    <StackPanel Margin="18">
                        <TextBlock Text="Entrada"
                                   Foreground="#FDE68A"
                                   FontSize="20"
                                   FontWeight="Bold"/>
                        <TextBlock Text="Sensores, pulsadores y modulos que capturan informacion del entorno."
                                   Foreground="#AAB4C3"
                                   FontSize="13"
                                   Margin="0,8,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource CategoryButtonStyle}"
                        Margin="0,0,0,14"
                        MouseEnter="Salidas_MouseEnter"
                        Click="Salidas_Click">
                    <StackPanel Margin="18">
                        <TextBlock Text="Salida"
                                   Foreground="#FDA4AF"
                                   FontSize="20"
                                   FontWeight="Bold"/>
                        <TextBlock Text="LEDs, pantallas, motores, buzzers y actuadores que muestran o producen una respuesta."
                                   Foreground="#AAB4C3"
                                   FontSize="13"
                                   Margin="0,8,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource CategoryButtonStyle}"
                        Margin="0,0,14,0"
                        MouseEnter="Alimentacion_MouseEnter"
                        Click="Alimentacion_Click">
                    <StackPanel Margin="18">
                        <TextBlock Text="Alimentacion"
                                   Foreground="#C4B5FD"
                                   FontSize="20"
                                   FontWeight="Bold"/>
                        <TextBlock Text="Fuentes, baterias, reguladores y convertidores que entregan energia estable al circuito."
                                   Foreground="#AAB4C3"
                                   FontSize="13"
                                   Margin="0,8,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Button>

                <Border Background="#10141C"
                        BorderBrush="#273142"
                        BorderThickness="1"
                        CornerRadius="8"
                        Margin="0">
                    <StackPanel Margin="18">
                        <TextBlock Text="Modo wiki"
                                   Foreground="#E5E7EB"
                                   FontSize="20"
                                   FontWeight="Bold"/>
                        <TextBlock Text="Cada componente incluye descripcion, uso, simbolo, polaridad, ejemplos y precauciones."
                                   Foreground="#AAB4C3"
                                   FontSize="13"
                                   Margin="0,8,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Margin="0,30,0,0"
                    Background="#0E1117"
                    BorderBrush="#273142"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="22">
                <StackPanel>
                    <TextBlock Text="Objetivo del proyecto"
                               Foreground="White"
                               FontSize="20"
                               FontWeight="Bold"/>
                    <TextBlock Text="Esta aplicacion esta pensada como una herramienta de consulta para estudiantes de soporte informatico y electronica basica. La idea es encontrar rapido un componente, entender su funcion y saber en que parte de un circuito se utiliza."
                               Foreground="#AAB4C3"
                               FontSize="14"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap"/>
                    <UniformGrid Columns="2"
                                 Margin="0,22,0,0">
                        <Border Background="#141922"
                                BorderBrush="#273142"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="18"
                                Margin="0,0,12,12">
                            <StackPanel>
                                <TextBlock Text="Objetivos"
                                           Foreground="#7DD3FC"
                                           FontSize="18"
                                           FontWeight="Bold"/>
                                <TextBlock Text="Organizar componentes por funcion, explicar sus usos principales y ayudar a reconocer datos importantes antes de conectarlos."
                                           Foreground="#AAB4C3"
                                           FontSize="13"
                                           Margin="0,8,0,0"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#141922"
                                BorderBrush="#273142"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="18"
                                Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Funcionamiento"
                                           Foreground="#A7F3D0"
                                           FontSize="18"
                                           FontWeight="Bold"/>
                                <TextBlock Text="El usuario navega por categorias. Cada ficha resume el componente y permite abrir una vista con detalles tecnicos."
                                           Foreground="#AAB4C3"
                                           FontSize="13"
                                           Margin="0,8,0,0"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#141922"
                                BorderBrush="#273142"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="18"
                                Margin="0,0,12,0">
                            <StackPanel>
                                <TextBlock Text="Mision"
                                           Foreground="#FDE68A"
                                           FontSize="18"
                                           FontWeight="Bold"/>
                                <TextBlock Text="Facilitar el aprendizaje de electronica basica con informacion clara, ordenada y util para practicas de laboratorio."
                                           Foreground="#AAB4C3"
                                           FontSize="13"
                                           Margin="0,8,0,0"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#141922"
                                BorderBrush="#273142"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="18">
                            <StackPanel>
                                <TextBlock Text="Vision"
                                           Foreground="#C4B5FD"
                                           FontSize="18"
                                           FontWeight="Bold"/>
                                <TextBlock Text="Convertirse en una mini wiki academica donde cualquier estudiante pueda consultar componentes de forma rapida e intuitiva."
                                           Foreground="#AAB4C3"
                                           FontSize="13"
                                           Margin="0,8,0,0"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
    </Grid>
</Page>
