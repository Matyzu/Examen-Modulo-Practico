<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Backgrounds: suave, ligeramente cálido para lectura cómoda -->
    <SolidColorBrush x:Key="WindowBackground" Color="#F6F8FA"/>
    <SolidColorBrush x:Key="PanelBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardBorder" Color="#E6EEF9"/>
    <SolidColorBrush x:Key="PopupBackground" Color="#FFFFFF"/>

    <!-- Foregrounds: contraste profesional y legible -->
    <SolidColorBrush x:Key="ForegroundPrimary" Color="#0F1724"/>
    <SolidColorBrush x:Key="ForegroundSecondary" Color="#64748B"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#0E7CFF"/>

    <!-- Accent / borders: tonos suaves y consistentes -->
    <SolidColorBrush x:Key="BorderBrushMain" Color="#E6EEF9"/>
    <SolidColorBrush x:Key="CardHoverBackground" Color="#F3F7FF"/>
    <SolidColorBrush x:Key="CardHoverBorder" Color="#0E7CFF"/>

</ResourceDictionary>
