<Page x:Class="Examen_Modulo_Practico_2.ComponentDetailPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Title="Detalles"
      Background="#101216">
    <Page.Resources>
        <Style x:Key="InfoBlockStyle" TargetType="Border">
            <Setter Property="Background" Value="#171C24"/>
            <Setter Property="BorderBrush" Value="#283242"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,16,16"/>
        </Style>
        <Style x:Key="MiniSpecStyle" TargetType="Border" BasedOn="{StaticResource InfoBlockStyle}">
            <Setter Property="MinHeight" Value="170"/>
        </Style>
        <Style x:Key="SheetCardStyle" TargetType="Border" BasedOn="{StaticResource InfoBlockStyle}">
            <Setter Property="MinHeight" Value="150"/>
        </Style>
        <Style x:Key="BackButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1E2632"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#3B82F6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="DatasheetLinkStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#DDE6F3"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="34">
            <Button Content="Volver"
                    Width="96"
                    HorizontalAlignment="Left"
                    Style="{StaticResource BackButtonStyle}"
                    Click="Back_Click"/>

            <TextBlock Text="{Binding Name}"
                       Foreground="White"
                       FontSize="38"
                       FontWeight="Bold"
                       Margin="0,28,0,2"
                       TextWrapping="Wrap"/>
            <TextBlock Text="{Binding Section}"
                       Foreground="#62D9FF"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Margin="0,0,0,18"/>

            <Border Background="#0E1117"
                    BorderBrush="#273142"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="18"
                    Margin="0,0,16,18">
                <TextBlock Text="Mini datasheet educativo: datos tecnicos organizados para reconocer el componente, comparar valores importantes, revisar terminales, evitar conexiones incorrectas y seleccionar alternativas comerciales antes de montar una practica real."
                           Foreground="#AAB4C3"
                           FontSize="15"
                           TextWrapping="Wrap"/>
            </Border>

            <UniformGrid Columns="2">
                    <Border Style="{StaticResource SheetCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Descripcion tecnica"
                                       Foreground="#7DD3FC"
                                       FontSize="20"
                                       FontWeight="Bold"/>
                            <TextBlock Text="{Binding TechnicalDetailsExtended}"
                                       Foreground="#AAB4C3"
                                       FontSize="14"
                                       LineHeight="21"
                                       Margin="0,8,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SheetCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Uso comun"
                                       Foreground="#A7F3D0"
                                       FontSize="18"
                                       FontWeight="Bold"/>
                            <TextBlock Text="{Binding CommonUseDetails}"
                                       Foreground="#AAB4C3"
                                       FontSize="14"
                                       LineHeight="21"
                                       Margin="0,8,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SheetCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Valores nominales"
                                       Foreground="#FDE68A"
                                       FontSize="18"
                                       FontWeight="Bold"/>
                            <TextBlock Text="{Binding NominalValuesDetails}"
                                       Foreground="#AAB4C3"
                                       FontSize="14"
                                       LineHeight="21"
                                       Margin="0,8,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SheetCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Caracteristicas electricas"
                                       Foreground="#C4B5FD"
                                       FontSize="18"
                                       FontWeight="Bold"/>
                            <TextBlock Text="{Binding ElectricalCharacteristicsExtended}"
                                       Foreground="#AAB4C3"
                                       FontSize="14"
                                       LineHeight="21"
                                       Margin="0,8,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SheetCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Circuito tipico de aplicacion"
                                       Foreground="#FDA4AF"
                                       FontSize="18"
                                       FontWeight="Bold"/>
                            <TextBlock Text="{Binding TypicalCircuitExtended}"
                                       Foreground="#AAB4C3"
                                       FontSize="14"
                                       LineHeight="21"
                                       Margin="0,8,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SheetCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Imagen del componente"
                                       Foreground="#62D9FF"
                                       FontSize="18"
                                       FontWeight="Bold"/>
                            <Border Height="224"
                                    Background="#0E1117"
                                    BorderBrush="#263141"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Margin="0,14,0,10">
                                <Image Source="{Binding ImagePath}"
                                       Stretch="Uniform"
                                       Margin="12"/>
                            </Border>
                            <TextBlock Text="Imagen referencial para reconocer el componente antes de consultar sus datos tecnicos."
                                       Foreground="#8D99AA"
                                       FontSize="12"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SheetCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Imagen de simulacion (datasheet)"
                                       Foreground="#62D9FF"
                                       FontSize="18"
                                       FontWeight="Bold"/>
                            <Border Height="224"
                                    Background="#0E1117"
                                    BorderBrush="#263141"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Margin="0,14,0,10">
                                <Image Source="{Binding DatasheetImage}"
                                       Stretch="Uniform"
                                       Margin="12"/>
                            </Border>
                            <TextBlock Text="Imagen tomada desde la carpeta Simulacion. Si no existe, se muestra la imagen esquematica por defecto."
                                       Foreground="#8D99AA"
                                       FontSize="12"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SheetCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Pines o terminales"
                                       Foreground="#A7F3D0"
                                       FontSize="18"
                                       FontWeight="Bold"/>
                            <TextBlock Text="{Binding PinsDetails}"
                                       Foreground="#AAB4C3"
                                       FontSize="14"
                                       LineHeight="21"
                                       Margin="0,8,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SheetCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Encapsulados o presentaciones"
                                       Foreground="#FDE68A"
                                       FontSize="18"
                                       FontWeight="Bold"/>
                            <TextBlock Text="{Binding PackageFormatsDetails}"
                                       Foreground="#AAB4C3"
                                       FontSize="14"
                                       LineHeight="21"
                                       Margin="0,8,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SheetCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Protocolo o forma de control"
                                       Foreground="#C4B5FD"
                                       FontSize="18"
                                       FontWeight="Bold"/>
                            <TextBlock Text="{Binding CommunicationProtocolDetails}"
                                       Foreground="#AAB4C3"
                                       FontSize="14"
                                       LineHeight="21"
                                       Margin="0,8,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SheetCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Identificacion"
                                       Foreground="#62D9FF"
                                       FontSize="18"
                                       FontWeight="Bold"/>
                            <TextBlock Text="{Binding IdentificationExtended}"
                                       Foreground="#AAB4C3"
                                       FontSize="14"
                                       LineHeight="21"
                                       Margin="0,8,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SheetCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Precaucion"
                                       Foreground="#FDA4AF"
                                       FontSize="18"
                                       FontWeight="Bold"/>
                            <TextBlock Text="{Binding SafetyNotesDetails}"
                                       Foreground="#AAB4C3"
                                       FontSize="14"
                                       LineHeight="21"
                                       Margin="0,8,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SheetCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Datasheets extra"
                                       Foreground="#7DD3FC"
                                       FontSize="18"
                                       FontWeight="Bold"/>
                            <TextBlock Text="Enlaces utiles para comparar hojas tecnicas populares o buscar variantes comerciales."
                                       Foreground="#8D99AA"
                                       FontSize="12"
                                       Margin="0,8,0,2"
                                       TextWrapping="Wrap"/>
                            <ItemsControl ItemsSource="{Binding ExtraDatasheets}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Style="{StaticResource DatasheetLinkStyle}">
                                            <Hyperlink NavigateUri="{Binding Url}"
                                                       RequestNavigate="Datasheet_RequestNavigate">
                                                <Run Text="{Binding Title}"/>
                                            </Hyperlink>
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SheetCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Resumen de hoja tecnica"
                                       Foreground="#7DD3FC"
                                       FontSize="18"
                                       FontWeight="Bold"/>
                            <TextBlock Text="{Binding DatasheetOverview}"
                                       Foreground="#AAB4C3"
                                       FontSize="14"
                                       Margin="0,8,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SheetCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Condiciones de operacion"
                                       Foreground="#A7F3D0"
                                       FontSize="18"
                                       FontWeight="Bold"/>
                            <TextBlock Text="{Binding OperatingNotes}"
                                       Foreground="#AAB4C3"
                                       FontSize="14"
                                       Margin="0,8,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SheetCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Seleccion y reemplazo"
                                       Foreground="#FDE68A"
                                       FontSize="18"
                                       FontWeight="Bold"/>
                            <TextBlock Text="{Binding SelectionGuide}"
                                       Foreground="#AAB4C3"
                                       FontSize="14"
                                       Margin="0,8,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SheetCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Checklist de laboratorio"
                                       Foreground="#C4B5FD"
                                       FontSize="18"
                                       FontWeight="Bold"/>
                            <TextBlock Text="{Binding LaboratoryChecklist}"
                                       Foreground="#AAB4C3"
                                       FontSize="14"
                                       Margin="0,8,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
            </UniformGrid>

            <UniformGrid Columns="2" Margin="0,6,0,0">
                <Border Style="{StaticResource MiniSpecStyle}">
                    <StackPanel>
                        <TextBlock Text="Recomendaciones de diseno"
                                   Foreground="#7DD3FC"
                                   FontSize="18"
                                   FontWeight="Bold"/>
                        <TextBlock Text="{Binding DesignRecommendationsDetails}"
                                   Foreground="#AAB4C3"
                                   FontSize="14"
                                   Margin="0,8,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource MiniSpecStyle}">
                    <StackPanel>
                        <TextBlock Text="Fallas comunes"
                                   Foreground="#FDA4AF"
                                   FontSize="18"
                                   FontWeight="Bold"/>
                        <TextBlock Text="{Binding FailureSymptomsDetails}"
                                   Foreground="#AAB4C3"
                                   FontSize="14"
                                   Margin="0,8,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </UniformGrid>
        </StackPanel>
    </ScrollViewer>
</Page>
